# Line endings. Git for Windows defaults to core.autocrlf=true, which rewrites files on
# checkout; these rules pin what actually matters instead of leaving it to each clone.
* text=auto

# setup.sh must keep LF. With CRLF a shell rejects it as `bad interpreter: ...^M` --
# which would not bite a cmd.exe user, but would break anyone running it under WSL or
# Git Bash, and those are exactly the Windows people most likely to reach for it.
*.sh text eol=lf

# Batch files are read by cmd.exe, which wants CRLF.
*.cmd text eol=crlf

# Notebooks are JSON and are diffed constantly; keep them LF everywhere so a Windows
# checkout does not show every notebook as modified.
*.ipynb text eol=lf

# Generated by `nids-setup.py env`, and tracked. The generator writes LF explicitly;
# this keeps a Windows checkout from converting it back and dirtying the tree.
env/requirements-*.txt text eol=lf
