# Local Helm overrides holding secrets -- never commit the CILogon client secret
# (see configs/values.yaml and docs/4_nrp_jupyterhub.md).
secrets.values.yaml
*.secret.yaml

# Credential files the dataset guides tell you to create: neo4j_credentials.env,
# .ucsdnts3.env, db_credentials.env (see datasets/). Commit the .env.example
# alongside them, never the real thing.
*.env
!*.env.example

# Scratch/working material -- z- prefixed files are not shipped repo content (CLAUDE.md).
z-*

# Local agent/editor/OS state.
.claude/settings.local.json
.DS_Store
__pycache__/

# The environment `nids-setup.py env` builds.
.venv/

# Generated requirements. requirements-local.txt is committed -- it is the reviewable
# record of what a student's laptop installs, and the only environment `env` actually
# builds, since on the hub the image supplies the packages. Ad-hoc subsets from
# `env --assignment` are not committed.
env/requirements-*.txt
!env/requirements-local.txt
!env/requirements-all.txt
